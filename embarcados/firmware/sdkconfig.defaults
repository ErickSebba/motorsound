# CPU fixa em 240 MHz, sem gerência de energia (CLAUDE.md de embarcados/, "Hardware")
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_PM_ENABLE=n
# Wi-Fi e BT nunca são iniciados pelo firmware; BT desligado na configuração
CONFIG_BT_ENABLED=n
# Otimização do app inteiro em -O2 ("performance"), sem asserts caros
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
# PSRAM: usada se existir; o firmware informa no INFO se ela foi encontrada
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
# Serial: console em UART0 a 921600 baud; logs só de aviso para não sujar o protocolo
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=921600
CONFIG_LOG_DEFAULT_LEVEL_WARN=y
# Tarefa principal com pilha folgada; a medição usa uma tarefa própria (ver main.c)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_TASK_WDT_EN=n
# Tabela de partições com a partição de dados "seq" (fluxo contínuo)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
